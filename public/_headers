# Cloudflare: logos, icons, posters and clips rarely change. A browser may reuse them for a day,
# and for a week after that while it checks for a newer copy (same as the old next.config headers).
/skills/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/reviews/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# photos made at build time never change under the same name
/_img/*
  Cache-Control: public, max-age=31536000, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
# the share picture has no file ending, so say what it is (WhatsApp / LinkedIn previews need this)
/opengraph-image
  Content-Type: image/png
