// then `npx wrangler deploy`. Plain files are free and don't count toward the daily request limit.
{
  "name": "cyrontech",
  "account_id": "fa851ad6cce28900b922b4b7988eabdb",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
